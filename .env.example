# Azure AI Vision multi-service resource (used for image analysis + OCR)
AI_SERVICE_ENDPOINT=https://your-ai-service-name.cognitiveservices.azure.com/
AI_SERVICE_KEY=your-ai-service-key

# Image classification model (Labfiles/02-image-classification)
CLASSIFICATION_PREDICTION_ENDPOINT=https://your-custom-vision-prediction.cognitiveservices.azure.com/
CLASSIFICATION_PREDICTION_KEY=your-classification-prediction-key
CLASSIFICATION_PROJECT_ID=your-classification-project-id
CLASSIFICATION_MODEL_NAME=your-published-iteration-name

# Object detection model (Labfiles/03-object-detection)
OBJECT_DETECTION_PREDICTION_ENDPOINT=https://your-custom-vision-prediction.cognitiveservices.azure.com/
OBJECT_DETECTION_PREDICTION_KEY=your-object-detection-prediction-key
OBJECT_DETECTION_PROJECT_ID=your-object-detection-project-id
OBJECT_DETECTION_MODEL_NAME=your-published-iteration-name

# Azure Face endpoint (if omitted, the app falls back to AI_SERVICE_ENDPOINT and AI_SERVICE_KEY)
FACE_API_ENDPOINT=
FACE_API_KEY=


